# Copy to .env.local for development. In production, set these in Netlify.

# Public URL of the app. Upload links in reminders are built from it.
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Postgres connection string. In production, use the Supabase pooled connection string.
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/cachaser
# Optional: a direct (non-pooled) connection used only to run migrations.
# DIRECT_URL=

# Signs session cookies and upload links. Generate with: openssl rand -base64 32
SESSION_SECRET=

# Shared secret for the daily reminder job. Generate with: openssl rand -base64 32
CRON_SECRET=

# Where uploaded files go. "local" is for development only; use "supabase" in production.
STORAGE_DRIVER=local
# SUPABASE_URL=https://your-project.supabase.co
# SUPABASE_SERVICE_ROLE_KEY=
# STORAGE_BUCKET=client-documents

# "mock" records reminders without sending them. "live" sends email through Resend.
MESSAGING_MODE=mock
# RESEND_API_KEY=
# EMAIL_FROM="Your Firm <reminders@yourdomain.in>"
